#!/bin/sh
# Installs or updates Rust's latest stable release with rustup, with clippy,
# rustfmt and the browser target wasm32-unknown-unknown, and makes it the
# default. Installed by `brew install aktagon/tap/rust-dev`; run it once per
# user, because rustup keeps Rust in each user's home folder, and again to update.
set -eu

# Formula/rust-dev.rb replaces this with Homebrew rustup's bin folder.
RUSTUP="@RUSTUP_BIN@/rustup"

case "${1:-}" in
-h | --help)
	echo "usage: rust-dev-setup"
	echo "Installs or updates Rust stable with rustup (clippy, rustfmt, wasm32-unknown-unknown) and makes it the default."
	exit 0
	;;
"") ;;
*)
	echo "rust-dev-setup: unknown argument: $1 (try --help)" >&2
	exit 2
	;;
esac

"$RUSTUP" toolchain install stable --profile minimal --component clippy,rustfmt --target wasm32-unknown-unknown
"$RUSTUP" default stable

# One Rust version per machine: name any other toolchain so the user can remove it.
others=$("$RUSTUP" toolchain list | grep -v '^stable-' || true)
if [ -n "$others" ]; then
	echo "rust-dev-setup: these toolchains are installed beside stable:" >&2
	echo "$others" >&2
	echo "Remove each with: rustup toolchain uninstall <name>" >&2
fi

"$RUSTUP" run stable rustc --version
